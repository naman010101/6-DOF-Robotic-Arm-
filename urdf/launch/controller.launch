<launch>

<rosparam file="$(find robotic_arm_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="robotic_arm" args="Base_Rotation_position_controller Revolute 8_position_controller Revolute 9_position_controller Revolute 10_position_controller Revolute 11_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/robotic_arm/joint_states"/>
</node>

</launch>